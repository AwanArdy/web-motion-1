---
import SectionTag from "./SectionTag.astro";
import Icon from "./Icon.astro";
import { experience } from "../data/portfolio";

const dots = ["#FF6B6B", "#FFC93C", "#6BCBFF"];
---

<section id="experience" class="py-16 sm:py-24 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-8">
    <div class="reveal lg:sticky lg:top-28 self-start" data-anime="fade">
      <SectionTag label="Experience" color="#9B5DE5" icon="star" />
      <h2 class="font-display uppercase mt-3 leading-none text-[clamp(1.9rem,6vw,3.2rem)]">
        Riwayat<br />kerja<span class="text-coral">.</span>
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft max-w-xs">
        Rekam jejak pengerjaan proyek software, mulai dari perancangan modul backend hingga optimasi performa web.
      </p>
      <div class="mt-5 flat-card p-4 flex items-center gap-3 bg-white max-w-xs">
        <div class="w-11 h-11 rounded-2xl bg-sun border-[3px] border-ink grid place-items-center" data-anime="float">
          <Icon name="rocket" size={20} strokeWidth={2} />
        </div>
        <div>
          <div class="font-display text-sm uppercase">2+ tahun</div>
          <div class="text-xs font-bold uppercase tracking-widest text-ink-soft">Pengalaman Praktis</div>
        </div>
      </div>
    </div>

    <div id="timeline" class="timeline-line pl-14 sm:pl-16 space-y-4 relative">
      <div id="timeline-progress" class="timeline-progress" aria-hidden="true"></div>
      {
        experience.map((item, i) => (
          <article class="reveal flat-card p-5 sm:p-6 bg-white relative" data-anime="fade">
            <span
              aria-hidden="true"
              class="absolute -left-14 sm:-left-16 top-5 w-10 h-10 rounded-full border-[3px] border-ink grid place-items-center font-black text-sm bg-white"
              style={`background:${dots[i % dots.length]}`}
            >
              {i + 1}
            </span>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="flat-chip bg-ink text-sun !border-ink">{item.period}</span>
              <span class="flat-chip bg-cream">{item.company}</span>
            </div>
            <h3 class="font-display text-lg sm:text-xl uppercase leading-tight">{item.role}</h3>
            <p class="text-sm leading-relaxed text-ink-soft mt-2">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
