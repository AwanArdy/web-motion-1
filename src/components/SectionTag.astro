---
import Icon from "./Icon.astro";
interface Props {
  label: string;
  color?: string;
  icon?: "sparkles" | "zap" | "star" | "pen" | "layers" | "play" | "mail" | "code" | "rocket";
}
const { label, color = "#FFC93C", icon = "sparkles" } = Astro.props;
---
<span
  class="flat-chip reveal"
  style={`background:${color}; color:#1E1E2E;`}
  data-anime="fade"
>
  <span aria-hidden="true" class="grid place-items-center w-5 h-5" data-anime-wiggle>
    <Icon name={icon} size={13} strokeWidth={2.5} />
  </span>
  {label}
</span>
