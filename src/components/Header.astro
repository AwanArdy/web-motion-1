---
import Icon from "./Icon.astro";
import { navItems, site } from "../data/portfolio";

const isHome = Astro.url.pathname === "/";
const resolveHref = (href: string) =>
  !isHome && href.startsWith("#") ? `/${href}` : href;
---

<header class="fixed top-0 left-0 right-0 z-50 px-3 sm:px-6 pt-3" data-anime="header">
  <nav
    aria-label="Navigasi utama"
    class="max-w-6xl mx-auto flex items-center justify-between gap-3 bg-paper/90 backdrop-blur-md border-[3px] border-ink rounded-2xl pl-4 pr-2 py-2 shadow-soft"
  >
    <a href="/" aria-label="Kembali ke beranda" class="flex items-center gap-2.5 shrink-0 group">
      <span class="w-10 h-10 rounded-xl bg-ink text-sun grid place-items-center font-display text-sm border-2 border-ink group-hover:bg-coral group-hover:text-white transition-colors">
        {site.initials}
      </span>
      <span class="hidden sm:block leading-none">
        <span class="block font-display text-sm">AWAN ARDY</span>
        <span class="block text-[11px] font-bold uppercase tracking-widest text-ink-soft">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-mint align-middle mr-1" data-anime="pulse"></span>Open to work
        </span>
      </span>
    </a>

    <ul class="hidden md:flex items-center gap-1 p-1 bg-cream border-2 border-ink/10 rounded-full">
      {
        navItems.map((item) => (
          <li>
            <a
              href={resolveHref(item.href)}
              data-nav-link-desktop
              class="px-4 py-2 block font-bold text-xs uppercase tracking-widest rounded-full hover:bg-sun transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={`mailto:${site.email}`}
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-sun border-[3px] border-ink rounded-xl font-bold text-xs uppercase tracking-wider hover:bg-ink hover:text-sun transition-colors min-h-[44px]"
        style="box-shadow: 0 4px 0 0 #1E1E2E;"
      >
        Hire Me <Icon name="zap" size={14} />
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="md:hidden w-11 h-11 grid place-items-center rounded-xl border-[3px] border-ink bg-white active:scale-95 transition-transform"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <Icon name="menu" size={20} class="menu-open" />
        <Icon name="x" size={20} class="menu-close hidden" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="md:hidden max-w-6xl mx-auto mt-2 overflow-hidden rounded-2xl border-[3px] border-ink bg-paper shadow-soft origin-top"
  >
    <nav aria-label="Navigasi seluler" class="p-2 grid gap-1" id="mobile-nav">
      {
        navItems.map((item) => (
          <a
            href={resolveHref(item.href)}
            data-nav-link
            class="mobile-link flex items-center justify-between px-4 py-3 rounded-xl font-bold uppercase tracking-widest text-sm border-2 border-transparent hover:border-ink hover:bg-sun transition-colors"
          >
            {item.label}
            <Icon name="arrow-right" size={16} class="opacity-40" />
          </a>
        ))
      }
      <a
        href={`mailto:${site.email}`}
        class="mobile-link mt-1 flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-ink text-sun font-bold uppercase tracking-widest text-sm"
      >
        <Icon name="zap" size={14} /> Hire Me
      </a>
    </nav>
  </div>
</header>

<script>
  import { animate, stagger } from "animejs";
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    const links = Array.from(menu.querySelectorAll(".mobile-link"));
    menu.toggleAttribute("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Tutup menu navigasi" : "Buka menu navigasi");
    toggle.querySelector(".menu-open")?.classList.toggle("hidden", open);
    toggle.querySelector(".menu-close")?.classList.toggle("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
    if (open && !reduced) {
      animate(links, {
        opacity: [0, 1],
        translateY: [14, 0],
        duration: 380,
        delay: stagger(45),
        ease: "outBack",
      });
      animate(menu, { scaleY: [0.92, 1], opacity: [0, 1], duration: 280, ease: "outCubic" });
    }
  };

  toggle?.addEventListener("click", () => setOpen(menu?.hasAttribute("hidden") ?? false));
  menu?.querySelectorAll("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hasAttribute("hidden")) setOpen(false);
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && menu && !menu.hasAttribute("hidden")) setOpen(false);
  });
</script>
