---
import Icon from "./Icon.astro";
import { site } from "../data/portfolio";
---

<section class="relative overflow-clip pt-28 sm:pt-32 pb-0" aria-label="Perkenalan" data-hero>
  <!-- Flat 2D sky scene -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-[#D8F0FF] via-cream to-cream"></div>
    <!-- sun -->
    <div class="absolute top-24 right-[8%] w-20 h-20 sm:w-28 sm:h-28" data-anime="sun">
      <div class="absolute inset-0 rounded-full bg-sun border-[3px] border-ink"></div>
      <div class="absolute inset-0 rounded-full border-[3px] border-dashed border-ink/20 scale-125" data-anime="spin"></div>
      <div class="absolute -inset-3 rounded-full bg-sun/20" data-anime="pulse"></div>
    </div>
    <!-- clouds: driven by anime.js (loop translateX) -->
    <div class="absolute top-32 left-0 w-full h-24 overflow-hidden pointer-events-none">
      <div class="absolute top-2 flex gap-16" data-anime="clouds">
        <svg width="120" height="40" viewBox="0 0 120 40" class="opacity-90"><g fill="#fff" stroke="#1E1E2E" stroke-width="3"><ellipse cx="35" cy="26" rx="22" ry="12"/><ellipse cx="65" cy="20" rx="24" ry="14"/><ellipse cx="90" cy="27" rx="18" ry="10"/></g></svg>
        <svg width="90" height="32" viewBox="0 0 120 40" class="opacity-70 mt-4"><g fill="#fff" stroke="#1E1E2E" stroke-width="3"><ellipse cx="35" cy="26" rx="22" ry="12"/><ellipse cx="65" cy="20" rx="24" ry="14"/></g></svg>
        <svg width="120" height="40" viewBox="0 0 120 40" class="opacity-90"><g fill="#fff" stroke="#1E1E2E" stroke-width="3"><ellipse cx="35" cy="26" rx="22" ry="12"/><ellipse cx="65" cy="20" rx="24" ry="14"/><ellipse cx="90" cy="27" rx="18" ry="10"/></g></svg>
      </div>
    </div>
    <!-- dots + hills -->
    <div class="absolute top-40 left-6 w-24 h-16 dots-bg opacity-60 rounded-2xl hidden sm:block"></div>
    <svg class="absolute bottom-0 left-0 w-full h-[120px] sm:h-[160px]" viewBox="0 0 1440 160" preserveAspectRatio="none" data-anime="hills">
      <path d="M0,90 C240,30 420,130 720,80 C1020,30 1200,110 1440,60 L1440,160 L0,160 Z" fill="#6BCB7F" stroke="#1E1E2E" stroke-width="4"/>
      <path d="M0,120 C300,90 600,140 900,110 C1100,95 1300,120 1440,105 L1440,160 L0,160 Z" fill="#9B5DE5" stroke="#1E1E2E" stroke-width="4"/>
      <g fill="#FFF8E7" stroke="#1E1E2E" stroke-width="3">
        <circle cx="200" cy="120" r="8"/><circle cx="700" cy="105" r="6"/><circle cx="1150" cy="115" r="8"/>
      </g>
    </svg>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-40 sm:pb-48 grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-8 items-center">
    <!-- Copy -->
    <div class="text-center lg:text-left" data-hero-copy>
      <div class="reveal inline-flex items-center gap-2 bg-white border-[3px] border-ink rounded-full pl-2 pr-4 py-1.5 shadow-soft mb-5" data-anime="fade">
        <span class="w-7 h-7 rounded-full bg-mint border-2 border-ink grid place-items-center" data-anime="pulse">
          <span class="w-2.5 h-2.5 rounded-full bg-ink"></span>
        </span>
        <span class="font-bold text-xs uppercase tracking-widest">Available for work</span>
        <span class="w-2 h-2 rounded-full bg-coral" data-anime="pulse"></span>
      </div>

      <h1 class="reveal font-display uppercase leading-[0.95] tracking-tight text-[clamp(2.6rem,9vw,5.5rem)]" data-anime="hero-title">
        Halo, saya
        <span class="block mt-1">
          <span class="inline-block" data-anime="float">
            <span class="inline-block bg-ink text-sun px-4 py-1 rounded-2xl -rotate-2">Awan</span>
          </span>
          <span class="inline-block ml-2" data-anime="float-alt">
            <span class="inline-flex items-center gap-2 bg-coral text-white px-4 py-1 rounded-2xl rotate-2">Ardy <Icon name="sparkles" size={28} strokeWidth={2.5} /></span>
          </span>
        </span>
      </h1>

      <p class="reveal mt-5 flex items-center justify-center lg:justify-start gap-3 font-bold text-xs sm:text-sm uppercase tracking-widest" data-anime="fade">
        <span class="hidden sm:block h-[3px] w-12 bg-ink rounded-full"></span>
        <span class="bg-sky border-2 border-ink rounded-full px-3 py-1">{site.role}</span>
        <span class="inline-flex items-center gap-1.5 bg-white border-2 border-ink rounded-full px-3 py-1">
          <Icon name="map-pin" size={13} strokeWidth={2.5} /> {site.location}
        </span>
      </p>

      <p class="reveal mt-5 text-base sm:text-lg leading-relaxed max-w-md mx-auto lg:mx-0 text-ink-soft" data-anime="fade">
        Saya membangun produk digital yang <strong class="text-ink bg-lime-pop px-1 rounded">cepat</strong>, <strong class="text-ink bg-sun px-1 rounded">skalabel</strong>, dan bermakna — dari database hingga UI, saya handle semuanya.
      </p>

      <div class="reveal mt-7 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start" data-anime="fade">
        <a href="#projects" class="flat-btn bg-ink text-cream text-sm hover:bg-coral">
          <Icon name="play" size={16} /> Lihat Proyek
        </a>
        <a href="#contact" class="flat-btn bg-white text-ink text-sm hover:bg-sun">
          Hubungi Saya <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="reveal mt-6 flex items-center justify-center lg:justify-start gap-3" data-anime="fade">
        <a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-12 h-12 grid place-items-center rounded-2xl border-[3px] border-ink bg-white hover:bg-ink hover:text-sun hover:-translate-y-1 transition-all">
          <Icon name="github" size={20} />
        </a>
        <a href={`mailto:${site.email}`} aria-label="Email" class="w-12 h-12 grid place-items-center rounded-2xl border-[3px] border-ink bg-white hover:bg-coral hover:text-white hover:-translate-y-1 transition-all">
          <Icon name="mail" size={20} />
        </a>
        <div class="hidden sm:flex items-center gap-2 ml-2 text-xs font-bold uppercase tracking-widest text-ink-soft">
          <span class="flex -space-x-2">
            <span class="w-7 h-7 rounded-full bg-peach border-2 border-ink grid place-items-center"><Icon name="zap" size={12} strokeWidth={2.5} /></span>
            <span class="w-7 h-7 rounded-full bg-sky border-2 border-ink grid place-items-center"><Icon name="code" size={12} strokeWidth={2.5} /></span>
            <span class="w-7 h-7 rounded-full bg-mint border-2 border-ink grid place-items-center"><Icon name="star" size={12} strokeWidth={2.5} /></span>
          </span>
          {site.experienceYears} experience
        </div>
      </div>
    </div>

    <!-- Flat 2D character card -->
    <div class="reveal flex justify-center lg:justify-end" data-anime="hero-card">
      <div class="relative w-full max-w-[360px]">
        <!-- floating badges -->
        <div aria-hidden="true" class="absolute -top-6 -left-4 z-10" data-anime="float">
          <div class="bg-white border-[3px] border-ink rounded-2xl px-3 py-2 text-xs font-bold shadow-soft rotate-[-6deg] inline-flex items-center gap-1.5">
            <Icon name="zap" size={13} strokeWidth={2.5} /> Fast API
          </div>
        </div>
        <div aria-hidden="true" class="absolute top-1/3 -right-3 sm:-right-6 z-10" data-anime="float-alt">
          <div class="bg-ink text-sun border-[3px] border-ink rounded-2xl px-3 py-2 text-xs font-bold rotate-[5deg] inline-flex items-center gap-1.5" style="box-shadow: 0 4px 0 0 #FF6B6B;">
            <Icon name="layers" size={13} strokeWidth={2.5} /> UI Juicy
          </div>
        </div>
        <div aria-hidden="true" class="absolute -bottom-4 left-8 z-10" data-anime="float">
          <div class="bg-sun border-[3px] border-ink rounded-full px-4 py-2 text-xs font-black uppercase tracking-widest inline-flex items-center gap-1.5 shadow-card-sm">
            <Icon name="map-pin" size={13} strokeWidth={2.5} /> Palu, ID
          </div>
        </div>

        <div class="flat-card overflow-hidden bg-white" data-tilt>
          <!-- browser bar -->
          <div class="flex items-center gap-1.5 px-4 py-3 border-b-[3px] border-ink bg-cream">
            <span class="w-3 h-3 rounded-full bg-coral border-2 border-ink"></span>
            <span class="w-3 h-3 rounded-full bg-sun border-2 border-ink"></span>
            <span class="w-3 h-3 rounded-full bg-mint border-2 border-ink"></span>
            <span class="ml-2 flex-1 text-[11px] font-bold bg-white border-2 border-ink/15 rounded-full px-3 py-1 truncate">awanardy.dev — about me</span>
          </div>
          <div class="p-5 sm:p-6 dots-bg">
            <!-- avatar flat -->
            <div class="mx-auto w-32 h-32 relative">
              <div class="absolute inset-0 rounded-[2rem] bg-sky border-[3px] border-ink rotate-3"></div>
              <div class="absolute inset-0 rounded-[2rem] bg-peach border-[3px] border-ink overflow-hidden grid place-items-center">
                <svg viewBox="0 0 100 100" class="w-24 h-24" aria-hidden="true">
                  <circle cx="50" cy="38" r="20" fill="#FFF8E7" stroke="#1E1E2E" stroke-width="4"/>
                  <circle cx="43" cy="36" r="3" fill="#1E1E2E"/><circle cx="57" cy="36" r="3" fill="#1E1E2E"/>
                  <path d="M42 46 Q50 52 58 46" stroke="#1E1E2E" stroke-width="3" fill="none" stroke-linecap="round"/>
                  <path d="M28 30 Q50 10 72 30 L70 22 Q50 6 30 22 Z" fill="#1E1E2E"/>
                  <rect x="28" y="60" width="44" height="30" rx="12" fill="#4361EE" stroke="#1E1E2E" stroke-width="4"/>
                  <circle cx="50" cy="70" r="4" fill="#FFC93C" stroke="#1E1E2E" stroke-width="2"/>
                </svg>
              </div>
              <div class="absolute -right-2 -top-2 w-9 h-9 rounded-full bg-coral border-[3px] border-ink grid place-items-center text-white" data-anime="wiggle">
                <Icon name="sparkles" size={14} strokeWidth={2.5} />
              </div>
            </div>

            <div class="mt-5 bg-ink text-white rounded-2xl p-4 font-mono text-xs leading-loose">
              <div><span class="text-sun">{"// about me"}</span></div>
              <div class="flex justify-between border-b border-white/10 py-1.5"><span class="text-white/50 uppercase tracking-widest">Name</span><span class="font-bold">Awan Ardy</span></div>
              <div class="flex justify-between border-b border-white/10 py-1.5"><span class="text-white/50 uppercase tracking-widest">Role</span><span class="font-bold text-mint">Fullstack Dev</span></div>
              <div class="flex justify-between border-b border-white/10 py-1.5"><span class="text-white/50 uppercase tracking-widest">Base</span><span class="font-bold">Palu, ID</span></div>
              <div class="flex justify-between py-1.5"><span class="text-white/50 uppercase tracking-widest">Status</span><span class="font-bold text-sun inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-mint inline-block"></span> Open</span></div>
            </div>

            <!-- build status bar -->
            <div class="mt-4 flex items-center gap-2 bg-mint/20 border-2 border-ink/10 rounded-full px-3 py-2">
              <span class="w-2.5 h-2.5 rounded-full bg-mint inline-block" data-anime="pulse"></span>
              <span class="text-xs font-bold truncate">npm run build — success in 1.2s</span>
              <span class="ml-auto grid place-items-center text-mint"><Icon name="check" size={14} strokeWidth={3} /></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
